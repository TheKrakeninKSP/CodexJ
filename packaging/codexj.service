[Unit]
Description=CodexJ journaling app (headless server)
After=network.target

[Service]
Type=simple
User=silverpeak
WorkingDirectory=/home/silverpeak/CodexJ/src
ExecStart=/home/silverpeak/CodexJ/src/.venv/bin/python -m backend.serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
